# Copy to .env and fill in what you use. Everything is optional except one LLM provider.

# ---- LLM providers (pick any; you choose provider + model in the Streamlit sidebar) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
# Any other OpenAI-compatible endpoint:
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Optional default model per provider, e.g. GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=
OPENAI_MODEL=
OPENROUTER_MODEL=
GROQ_MODEL=
GEMINI_MODEL=
DEEPSEEK_MODEL=
MISTRAL_MODEL=
TOGETHER_MODEL=
OLLAMA_MODEL=
LMSTUDIO_MODEL=
CUSTOM_MODEL=

# ---- Data sources ----
# GitHub: read-only fine-grained token (public repos). Raises search limit from 10 to 30 requests/min.
GITHUB_TOKEN=
# Stack Exchange: free key from stackapps.com. Raises quota from 300 to 10,000 requests/day.
STACKAPPS_KEY=
# YouTube Data API v3 key (Google Cloud console). Required for the YouTube source.
YOUTUBE_API_KEY=
# Bluesky: only needed if public search is blocked. Use an App Password, not your main password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Salt for hashing usernames (generated automatically into data/.salt if empty)
IDEA_MINER_SALT=
